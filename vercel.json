{
	"rewrites": [
		{
			"source": "/h2h/:path*",
			"destination": "https://h2h-puce.vercel.app/:path*"
		},
		{
			"source": "/h2h",
			"destination": "https://h2h-puce.vercel.app/"
		},
		{
			"source": "/api/:path*",
			"destination": "/api/content?path=api/:path*"
		},
		{
			"source": "/:path*.md",
			"destination": "/api/content?path=:path*.md"
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "header",
					"key": "accept",
					"value": ".*text/markdown.*"
				}
			],
			"destination": "/api/content?path=:path*"
		}
	],
	"framework": "astro",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"headers": [
		{
			"source": "/_astro/:path*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/:path*",
			"headers": [
				{
					"key": "Vary",
					"value": "Accept"
				}
			]
		}
	]
}
